+  // Independently request link-level HDCP on the native i915 HDMI output.
+  // Keep the request on the existing DRM-master device. Never fail a normal
+  // frame because HDCP is unsupported or its negotiation has not succeeded.
+  // This does not make the Widevine L3 DRM plug-in HDCP-policy compliant.
+  if (!hdcp_request_attempted_ && connector->IsConnected() &&
+      connector->GetName().rfind("HDMI-A-", 0) == 0) {
+    char gpu[PROPERTY_VALUE_MAX] = {};
+    property_get("ro.vendor.graphics.gpu", gpu, "");
+    char product[PROPERTY_VALUE_MAX] = {};
+    property_get("ro.product.device", product, "");
+    if (std::strcmp(gpu, "i915") == 0 &&
+        std::strcmp(product, "r86s_virtio_tv") == 0) {
+      hdcp_request_attempted_ = true;
+      DrmProperty protection;
+      if (drm->GetProperty(connector->GetId(), DRM_MODE_OBJECT_CONNECTOR,
+                           "Content Protection", &protection) == 0) {
+        const auto [desired, enum_err] =
+            protection.GetEnumValueWithName("Desired");
+        if (enum_err == 0) {
+          auto hdcp_pset = MakeDrmModeAtomicReqUnique();
+          if (hdcp_pset && protection.AtomicSet(*hdcp_pset, desired)) {
+            const int hdcp_err =
+                drmModeAtomicCommit(*drm->GetFd(), hdcp_pset.get(),
+                                    DRM_MODE_ATOMIC_ALLOW_MODESET, drm);
+            if (hdcp_err != 0) {
+              ALOGW("HDCP link protection request failed for %s: %d",
+                    connector->GetName().c_str(), hdcp_err);
+            } else {
+              ALOGI("HDCP Desired requested for %s (authentication unverified)",
+                    connector->GetName().c_str());
+            }
+          }
+        }
+      }
+    }
+  }
