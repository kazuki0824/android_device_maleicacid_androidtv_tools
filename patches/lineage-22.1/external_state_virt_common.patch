+# Discover persistent GRUB state independently of the replaceable boot disk.
+# vdd may be a whole-disk FAT32 volume, whereas stock uses (hdX,gpt4/9).
+search.fs_label PERSIST partition_persist
+if [ -z "$partition_persist" ]; then
+    echo "ERROR: PERSIST volume not found"
+    sleep 5
+    reboot
+fi
 set partition_persist="(${partition_persist})"
 export partition_persist
 
-# Match and set disk name using the ugly way, as there is no way to extract substring from string yet...
-if [ "$partition_persist" = "(hd2,gpt4)" ]; then
-	set disk_boot=hd2
-elif [ "$partition_persist" = "(hd2,gpt9)" ]; then
-	set disk_boot=hd2
-elif [ "$partition_persist" = "(hd1,gpt4)" ]; then
-	set disk_boot=hd1
-elif [ "$partition_persist" = "(hd1,gpt9)" ]; then
-	set disk_boot=hd1
-else
-	set disk_boot=hd0
+# Discover the actual boot ESP by the marker installed by make-espimage.
+# Never infer the system disk from the (possibly external) PERSIST volume.
+search --file --no-floppy --set=boot_esp /boot/grub/.is_esp_part_on_android_boot_device
+if [ -z "$boot_esp" ]; then
+    echo "ERROR: Android boot ESP marker missing"
+    sleep 5
+    reboot
 fi
+if ! regexp --set=1:disk_boot '^([^,]+),gpt[0-9]+$' "$boot_esp"; then
+    echo "ERROR: unexpected Android boot ESP: $boot_esp"
+    sleep 5
+    reboot
+fi
 export disk_boot
 
