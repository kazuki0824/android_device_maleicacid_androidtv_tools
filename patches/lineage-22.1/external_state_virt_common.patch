diff --git a/configs/scripts/create_partition_table.sh b/configs/scripts/create_partition_table.sh
--- a/configs/scripts/create_partition_table.sh
+++ b/configs/scripts/create_partition_table.sh
@@ -5,6 +5,13 @@
 DISK_NAME=$3
 AB_OTA_UPDATER=$4
 SUPER_SIZE=$5
+EXTERNAL_PERSISTENT_DISKS=${6:-false}
+PERSIST_PARTITION_NAME=persist
+METADATA_PARTITION_NAME=metadata
+if [ "$EXTERNAL_PERSISTENT_DISKS" = true ]; then
+    PERSIST_PARTITION_NAME=persist-unused
+    METADATA_PARTITION_NAME=metadata-unused
+fi
 
 if [ ! -x "$SGDISK_EXEC" ] || [ ! -w "$TARGET" ] || [ -z "$DISK_NAME" ]; then
     exit 1
@@ -25,8 +32,8 @@
                 # https://source.android.com/docs/core/ota/dynamic_partitions/how_to_size_super#full_super_without_compression
                 $SGDISK_EXEC --new=2:0:+12G --change-name=2:super $TARGET
